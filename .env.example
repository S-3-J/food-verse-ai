# Food Verse AI - environment configuration
# Copy to .env and fill in the values you need. All variables are optional:
# without any API key the app runs in Demo / Fallback Mode.

# Demo / Fallback Mode | Gemini (Google) | Groq
FOOD_VERSE_PROVIDER="Demo / Fallback Mode"

# Provider keys (only the one matching the provider is needed)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Model ids, one per provider. The model always follows the selected provider
# in the UI - it cannot be typed in the app. Leave a value empty to run that
# provider on heuristic (demo) results.
GEMINI_MODEL=
GROQ_MODEL=

# Optional sampling temperature (0.0 - 1.0)
TEMPERATURE=0.3

# Security: set to true to let visitors paste their own API key in the app.
# Keep false for public deployments so the server-managed key is never exposed.
ALLOW_USER_API_KEY=false

# Security: max live-provider analyses per browser session (0 disables the cap)
MAX_RUNS_PER_SESSION=25
